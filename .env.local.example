# For docker-compose.local.yml. Copy to `.env.local` and fill in.
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored. This example is not, and must never carry a real key.

# ── Required ──────────────────────────────────────────────────────────────────

# The PM agent has NO scripted double: all three of its operations call a model. Without a key
# the compose refuses to start, which is better than starting an agent that 502s every request.
#
# `openrouter/free` costs nothing. Give the key a credit limit in the OpenRouter dashboard
# anyway: it is the only ceiling that does not depend on this code behaving.
OPENROUTER_API_KEY=sk-or-v1-...

# Two secrets, deliberately different. Reusing one would make the isolation between the two
# agents untestable — and the test that matters is that the backend's token is REJECTED by the
# PM agent.
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MIRAG_TOKEN=local-backend-cambiame
MIRAG_PM_TOKEN=local-pm-cambiame

# ── Optional ──────────────────────────────────────────────────────────────────

# The models. Both default to free ones that were PROBED for tool calling, which is what
# everything here depends on: the PM delivers a plan through a tool, and the backend delivers
# a project through `specify_project` and `deliver_group`. A model that answers in prose
# produces an empty delivery and looks like a broken agent.
#
# Of the twenty free models advertising tool support, these two answered correctly when probed
# directly. If one starts failing, probe another before concluding the wiring is broken.
# MIRAG_PM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# MIRAG_BACKEND_MODEL=poolside/laguna-s-2.1:free

# Per-request spending cap. Low on purpose for local work.
# MIRAG_BUDGET_USD=0.10
