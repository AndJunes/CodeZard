GATEWAY_LOG_LEVEL=INFO
GATEWAY_PORT=8000

# Two agents, two tokens — each the SAME value as the matching MIRAG_TOKEN in that agent's own
# .env (agente-backend/.env for the backend; whatever launches `mirag-pm` for the PM).
# Generate them, do not invent them:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# docker-compose.yml reads them from here. A local run (`gateway`) only reads GATEWAY_
# variables, so there each token also goes inside GATEWAY_ORCHESTRATION__*_TOKEN below.
MIRAG_TOKEN=
MIRAG_PM_TOKEN=

# The two services the run orchestrator drives: /runs -> these, never called directly by a
# client. Names must stay "backend" and "pm" — GATEWAY_ORCHESTRATION__BACKEND_SERVICE /
# PM_SERVICE default to them. No "headers" here on purpose: the orchestrator attaches
# X-Mirag-Token itself, from the ORCHESTRATION tokens below, per request rather than per
# service. The agent defaults to port 8000 too; run the backend locally with MIRAG_PORT=8100
# and the PM with MIRAG_PORT=8101.
GATEWAY_SERVICES='[{"name": "backend", "base_url": "http://127.0.0.1:8100", "timeout_seconds": 10, "read_timeout_seconds": 600, "health_path": "/api/v1/health"}, {"name": "pm", "base_url": "http://127.0.0.1:8101", "timeout_seconds": 10, "read_timeout_seconds": 600, "health_path": "/api/v1/health"}]'

# Without ENABLED=true, POST /runs and everything under it are never registered: the front
# end's "send" then gets a plain 404 from here, with nothing to explain why.
GATEWAY_ORCHESTRATION__ENABLED=true
GATEWAY_ORCHESTRATION__PM_TOKEN=${MIRAG_PM_TOKEN}
GATEWAY_ORCHESTRATION__BACKEND_TOKEN=${MIRAG_TOKEN}
# Spanish, because the screen is. The agents default to English on their side, so leaving this
# out is a Spanish page talking to an English agent — which reads as the agent refusing to
# answer rather than as a locale mismatch.
GATEWAY_ORCHESTRATION__LOCALE=es

GATEWAY_RETRY__MAX_ATTEMPTS=3
GATEWAY_RETRY__BASE_DELAY_SECONDS=0.1

GATEWAY_CIRCUIT_BREAKER__FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER__RECOVERY_TIMEOUT_SECONDS=30
