GATEWAY_LOG_LEVEL=INFO
GATEWAY_PORT=8000

# One agent process now: agente-backend's `python -m mirag_manager serve` (port 8100), with both
# "agents" inside it and ONE shared token — the SAME MIRAG_TOKEN that process's own .env
# carries. Generate it, do not invent it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Written once, here: both ORCHESTRATION tokens below read it, so a local run (`gateway`) and
# docker-compose.yml share the same line.
MIRAG_TOKEN=

# The two services the run orchestrator drives: /runs -> these, never called directly by a
# client. Names must stay "backend" and "pm" — GATEWAY_ORCHESTRATION__BACKEND_SERVICE /
# PM_SERVICE default to them. Both point at the SAME manager, one port: only the path prefix
# differs ("/backend/..." and "/pm/..."). Two entries because the orchestrator calls them by
# two names, not because they are two processes. No "headers" here on purpose: the
# orchestrator attaches X-Mirag-Token itself, per request, from the ORCHESTRATION tokens below.
# The manager listens on MIRAG_PORT, whose default (8000) is THIS gateway's port: set
# MIRAG_PORT=8100 in agente-backend/.env.
GATEWAY_SERVICES='[{"name":"backend","base_url":"http://127.0.0.1:8100/backend","timeout_seconds":10,"read_timeout_seconds":600,"health_path":"/api/v1/health"},{"name":"pm","base_url":"http://127.0.0.1:8100/pm","timeout_seconds":10,"read_timeout_seconds":600,"health_path":"/api/v1/health"}]'

# Without ENABLED=true, POST /runs and everything under it are never registered: the front
# end's "send" then gets a plain 404 from here, with nothing to explain why.
GATEWAY_ORCHESTRATION__ENABLED=true
GATEWAY_ORCHESTRATION__PM_TOKEN=${MIRAG_TOKEN}
GATEWAY_ORCHESTRATION__BACKEND_TOKEN=${MIRAG_TOKEN}
# Spanish, because the screen is. The agents default to English on their side, so leaving this
# out is a Spanish page talking to an English agent — which reads as the agent refusing to
# answer rather than as a locale mismatch.
GATEWAY_ORCHESTRATION__LOCALE=es

GATEWAY_RETRY__MAX_ATTEMPTS=3
GATEWAY_RETRY__BASE_DELAY_SECONDS=0.1

GATEWAY_CIRCUIT_BREAKER__FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER__RECOVERY_TIMEOUT_SECONDS=30

# Off by default: it lets the front run commands on this machine. Also needs MIRAG_CONSOLE=1 on the agent.
GATEWAY_ORCHESTRATION__CONSOLE=false

# ── Billing: subscriptions, token packs and x402, settled on Stellar ──────────
#
# Off by default, like orchestration. With it off, POST /runs charges nobody and behaves
# exactly as it did before any of this existed — which is what a local stack wants.
#
# With it on, a run needs either a signed-in account with a balance or an X-PAYMENT header,
# and anything else gets a 402 quoting the price.
GATEWAY_BILLING__ENABLED=false

# testnet | public. `public` is real money and is refused unless ALLOW_MAINNET is set as well:
# two settings for one decision, because a typo, a copied .env or an inherited environment
# variable can produce "public" and none of them can produce both.
GATEWAY_BILLING__NETWORK=testnet
GATEWAY_BILLING__ALLOW_MAINNET=false

# The Stellar address payments arrive at. Public data — this process RECEIVES and never sends,
# so it holds no secret key at all. Create one with a wallet, or on testnet with Friendbot.
GATEWAY_BILLING__DESTINATION=

# Signs session tokens. No default on purpose: a factory secret is one everybody has, and here
# it would forge sign-ins. Generate it, do not invent it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_BILLING__SECRET=

# XLM | USDC. USDC also needs its issuer — an asset code without one is not an asset, and
# anyone can issue something called USDC.
GATEWAY_BILLING__ASSET=XLM
# GATEWAY_BILLING__USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Fallback XLM/USD rate, used only when the DEX cannot be asked (a testnet with no liquidity,
# or a Horizon having a bad minute). Empty means no fallback: an invoice that cannot be priced
# is refused rather than guessed at.
GATEWAY_BILLING__XLM_USD=0.10

# The ledger. The ONE piece of state in this process that must survive a restart: runs and
# their logs are deliberately forgetful, a balance is not.
GATEWAY_BILLING__DATABASE=var/billing.sqlite3

# Tokens an account must hold before a run may start. Never debited — a floor, so a generation
# is refused before it begins rather than halfway through one somebody is watching.
GATEWAY_BILLING__RESERVE_TOKENS=50000

# x402: answer 402 with payment requirements and accept X-PAYMENT. On by default WITHIN
# billing, and does nothing at all while ENABLED is false.
GATEWAY_BILLING__X402=true
GATEWAY_BILLING__X402_PRICE_USD=0.50

# Also act as an x402 facilitator for other people's resources (/x402/verify, /x402/settle).
# Off unless asked for: it makes this gateway submit transactions handed to it by strangers.
GATEWAY_BILLING__FACILITATOR=false
