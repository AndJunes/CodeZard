GATEWAY_LOG_LEVEL=INFO
GATEWAY_PORT=8000

# Microservices the gateway can route to: /api/{name}/... -> {base_url}/...
GATEWAY_SERVICES='[{"name": "users", "base_url": "http://localhost:8001"}, {"name": "orders", "base_url": "http://localhost:8002", "timeout_seconds": 10}]'

GATEWAY_RETRY__MAX_ATTEMPTS=3
GATEWAY_RETRY__BASE_DELAY_SECONDS=0.1

GATEWAY_CIRCUIT_BREAKER__FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER__RECOVERY_TIMEOUT_SECONDS=30
