GATEWAY_LOG_LEVEL=INFO
GATEWAY_PORT=8000

# Shared secret with the backend agent (Mirag): the SAME value as MIRAG_TOKEN in the agent's .env.
# Generate it, do not invent it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# docker-compose.yml reads it from here. A local run (`gateway`) only reads GATEWAY_ variables,
# so there the token goes inside GATEWAY_SERVICES below.
MIRAG_TOKEN=

# Microservices the gateway can route to: /api/{name}/... -> {base_url}/...
# The agent also defaults to port 8000; run it locally with MIRAG_PORT=8100.
GATEWAY_SERVICES='[{"name": "mirag", "base_url": "http://127.0.0.1:8100", "timeout_seconds": 180, "health_path": "/api/v1/health", "headers": {"X-Mirag-Token": "same-value-as-MIRAG_TOKEN"}}]'

# Several agents at once (one per port, all with the same MIRAG_TOKEN): "base_urls" instead of
# "base_url". Requests are spread among them and a stopped agent is skipped.
# GATEWAY_SERVICES='[{"name": "mirag", "base_urls": ["http://127.0.0.1:8100", "http://127.0.0.1:8101"], "timeout_seconds": 180, "health_path": "/api/v1/health", "headers": {"X-Mirag-Token": "same-value-as-MIRAG_TOKEN"}}]'

GATEWAY_RETRY__MAX_ATTEMPTS=3
GATEWAY_RETRY__BASE_DELAY_SECONDS=0.1

GATEWAY_CIRCUIT_BREAKER__FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER__RECOVERY_TIMEOUT_SECONDS=30
